# ==========================================
# Textra NLP Studio - Environment Configuration Template
# Copy this file to .env.local to activate real external services
# ==========================================

# 1. Stanford CoreNLP Server
CORENLP_URL=http://localhost:9000
NEXT_PUBLIC_CORENLP_URL=http://localhost:9000

# 2. Brevo (formerly Sendinblue) Transactional SMTP Relay
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_login_email@example.com
BREVO_SMTP_KEY=your_brevo_smtp_master_api_key
BREVO_FROM_EMAIL=verify@textra-nlp.com
BREVO_FROM_NAME="Textra NLP Studio"

# 3. Social Authentication Providers (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# 4. Database Configuration (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=textra_nlp

# 5. Next.js App URL & Secrets
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=your_generated_random_secret_string_32_chars_or_more
